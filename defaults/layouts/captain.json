{
  "id": "root",
  "type": "row",
  "theme": {
    "light": "captain-light",
    "dark": "captain-dark"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "nav",
      "type": "column",
      "size": {
        "px": 216
      },
      "resizable": false,
      "children": [
        {
          "id": "nav-brand",
          "type": "block",
          "size": {
            "px": 56
          },
          "window_drag": true,
          "content": {
            "mod": "captain-nav",
            "props": {
              "part": "brand"
            }
          }
        },
        {
          "id": "nav-sections",
          "type": "block",
          "content": {
            "mod": "captain-nav"
          }
        }
      ]
    },
    {
      "id": "sections",
      "type": "stack",
      "active": "investigations",
      "min": 520,
      "children": [
        {
          "id": "investigations",
          "type": "block",
          "content": {
            "mod": "captain-investigations"
          }
        },
        {
          "id": "data",
          "type": "block",
          "content": {
            "mod": "captain-data"
          }
        },
        {
          "id": "runs",
          "type": "block",
          "content": {
            "mod": "captain-runs"
          }
        },
        {
          "id": "comparisons",
          "type": "block",
          "content": {
            "mod": "captain-compare"
          }
        },
        {
          "id": "handoff",
          "type": "block",
          "content": {
            "mod": "captain-handoff"
          }
        },
        {
          "id": "engine",
          "type": "block",
          "content": {
            "mod": "captain-engine"
          }
        },
        { "id": "project", "type": "block", "content": { "mod": "captain-project" } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "size": {
        "px": 460
      },
      "min": 300,
      "max": 900,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs",
            "props": {
              "inset": false
            }
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
