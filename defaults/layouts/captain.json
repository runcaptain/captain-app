{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "nav",
      "type": "column",
      "size": {
        "px": 216
      },
      "resizable": false,
      "background": "chrome",
      "children": [
        {
          "id": "nav-brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "captain-nav",
            "props": {
              "part": "brand"
            }
          }
        },
        {
          "id": "nav-sections",
          "type": "block",
          "content": {
            "mod": "captain-nav"
          }
        }
      ]
    },
    {
      "id": "sections",
      "type": "stack",
      "active": "explore",
      "min": 520,
      "children": [
        {
          "id": "explore",
          "type": "block",
          "content": {
            "webview": {
              "url": "{cst}/ui/explore?embed=1",
              "id": "explore"
            }
          }
        },
        {
          "id": "pipelines",
          "type": "block",
          "content": {
            "webview": {
              "url": "{cst}/ui/pipelines?embed=1",
              "id": "pipelines"
            }
          }
        },
        {
          "id": "evaluate",
          "type": "block",
          "content": {
            "webview": {
              "url": "{cst}/ui/evaluate?embed=1",
              "id": "evaluate"
            }
          }
        },
        {
          "id": "deploys",
          "type": "block",
          "content": {
            "webview": {
              "url": "{cst}/ui/deploys?embed=1",
              "id": "deploys"
            }
          }
        },
        {
          "id": "workflows",
          "type": "block",
          "content": {
            "webview": {
              "url": "{cst}/ui/workflows?embed=1",
              "id": "workflows"
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "size": {
        "px": 460
      },
      "min": 300,
      "max": 900,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
