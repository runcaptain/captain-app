#!/bin/bash
# CAPTAIN: installs Captain.app, never Herdr.app. Herdr's bundle and its
# ~/.local/bin/herdr-app link are not touched. Builds with
# scripts/package-captain-macos, then copies the bundle in place.
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This installer requires macOS.' >&2; exit 1; }
cd "$(dirname "$0")/.."
scripts/package-captain-macos

app="$HOME/Applications/Captain.app"
mkdir -p "$HOME/Applications" "$HOME/.local/bin"
# Replace atomically so installing does not interrupt a running Captain.
rm -rf "$app.new"
cp -R dist/Captain.app "$app.new"
rm -rf "$app.old"
[[ -e "$app" ]] && mv "$app" "$app.old"
mv "$app.new" "$app"
rm -rf "$app.old"
ln -sfn "$app/Contents/MacOS/Captain" "$HOME/.local/bin/captain-app"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
echo "Installed $app. Quit and reopen Captain to use the new build."
