# Copy to server.env (ignored), chmod 600, and supply database credentials privately.
CST_TEAM_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
CST_TEAM_AUTH_MODE=tokens
# Optional S3 adapter; otherwise the Compose artifact volume stores bytes.
# CST_TEAM_ARTIFACT_BUCKET=private-team-artifacts
# CST_TEAM_ARTIFACT_PREFIX=team-sync
# For compose.postgres.yaml, set this and use the same URL-encoded password above:
# CST_TEAM_POSTGRES_PASSWORD=GENERATE_A_DEDICATED_PASSWORD
# Optional future SSO mode, not required for token setup:
# CST_TEAM_AUTH_MODE=oidc
# CST_TEAM_OIDC_ISSUER=https://identity.example/
# CST_TEAM_OIDC_AUDIENCE=captain-team-api
# CST_TEAM_OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json
